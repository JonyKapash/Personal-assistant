# --- Anthropic (AI brain) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for the assistant
ANTHROPIC_MODEL=claude-opus-4-8

# --- Owner identity (you) ---
OWNER_NAME=Yoni
OWNER_EMAIL=yonipr@gmail.com
# Your personal WhatsApp number in international format, digits only (e.g. 9725XXXXXXXX).
# Messages from this number get full admin control; everyone else gets the
# client-facing booking assistant.
OWNER_WHATSAPP=9725XXXXXXXX
# Name clients see, e.g. "Yoni's Clinic" (defaults to OWNER_NAME)
BUSINESS_NAME=
TIMEZONE=Asia/Jerusalem

# --- Working hours used when proposing appointment slots ---
WORK_DAY_START=09:00
WORK_DAY_END=18:00
DEFAULT_APPOINTMENT_MINUTES=60

# --- Google (Gmail + Calendar) ---
# Create an OAuth client (Desktop app) in Google Cloud Console with the
# Gmail and Calendar APIs enabled, then run: npm run auth:google
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_TOKEN_PATH=./data/google-token.json
GOOGLE_CALENDAR_ID=primary
# How often to check the inbox for new emails (seconds)
GMAIL_POLL_SECONDS=60
# How often to scan the calendar for changes made outside the assistant (seconds)
CALENDAR_WATCH_SECONDS=300

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=1234567890
# Any string you choose; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# Your Meta app secret (App settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Server ---
PORT=3000
# Path to the SQLite database file
DB_PATH=./data/assistant.db
